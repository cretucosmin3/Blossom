<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ApplicationIcon>icon64.ico</ApplicationIcon>
        <RootNamespace>Blossom</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Adding assets to bin and publish folders -->
    <Target Name="CopyAssets" AfterTargets="AfterBuild;Publish">
        <ItemGroup>
            <_AssetFiles Include="$(MSBuildProjectDirectory)\assets\**" />
            <_GlfwFiles Include="$(MSBuildProjectDirectory)\glfw\**" />
        </ItemGroup>
        <PropertyGroup>
            <_DestinationFolder Condition="'$(PublishDir)' != ''">$(PublishDir)</_DestinationFolder>
            <_DestinationFolder Condition="'$(PublishDir)' == ''">$(OutDir)</_DestinationFolder>
        </PropertyGroup>
        <Copy SourceFiles="@(_AssetFiles)" DestinationFolder="$(_DestinationFolder)assets\%(RecursiveDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_GlfwFiles)" DestinationFolder="$(_DestinationFolder)%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" />
    <ItemGroup>
        <PackageReference Include="Silk.NET" Version="2.15.0" />
        <PackageReference Include="Silk.NET.Core" Version="2.15.0" />
        <PackageReference Include="Silk.NET.Windowing.Common" Version="2.15.0" />
        <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.15.0" />
        <PackageReference Include="System.Drawing.Common" Version="6.0.0-rc.2.21480.5" />
        <PackageReference Include="SkiaSharp" Version="2.88.3" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.3" />
        <PackageReference Include="SixLabors.ImageSharp" Version="2.1.2" />
        <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    </ItemGroup>
</Project>