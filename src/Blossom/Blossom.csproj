<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Blossom</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Description>Retained-mode UI framework for C# (Silk.NET + SkiaSharp).</Description>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\assets\fonts\roboto.medium.ttf" LogicalName="Blossom.assets.fonts.roboto.medium.ttf" />
        <EmbeddedResource Include="..\..\assets\fonts\roboto.light.ttf" LogicalName="Blossom.assets.fonts.roboto.light.ttf" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET" Version="2.15.0" />
        <PackageReference Include="Silk.NET.Core" Version="2.15.0" />
        <PackageReference Include="Silk.NET.Windowing.Common" Version="2.15.0" />
        <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.15.0" />
        <PackageReference Include="System.Drawing.Common" Version="6.0.0-rc.2.21480.5" />
        <PackageReference Include="SkiaSharp" Version="2.88.3" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.3" />
        <PackageReference Include="SixLabors.ImageSharp" Version="2.1.2" />
        <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    </ItemGroup>
</Project>
