<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Blossom</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Description>Retained-mode UI framework for C# (Silk.NET + SkiaSharp).</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\assets\fonts\roboto.medium.ttf" LogicalName="Blossom.assets.fonts.roboto.medium.ttf" />
        <EmbeddedResource Include="..\..\assets\fonts\roboto.light.ttf" LogicalName="Blossom.assets.fonts.roboto.light.ttf" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Windowing.Common" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
        <PackageReference Include="SkiaSharp" Version="4.153.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="Svg.Skia" Version="5.2.3" />
    </ItemGroup>
</Project>
