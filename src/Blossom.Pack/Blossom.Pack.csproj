<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Title>Blossom</Title>
        <Description>Retained-mode UI framework for C# (Silk.NET + SkiaSharp), including reactive signals and layout primitives.</Description>
        <PackageTags>ui;desktop;skia;retained;signals</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</PackageOutputPath>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackBlossomAssemblies</TargetsForTfmSpecificContentInPackage>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Blossom\Blossom.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Blossom.Reactive\Blossom.Reactive.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Blossom.Primitives\Blossom.Primitives.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- Runtime packages the three libraries need. PrivateAssets on ProjectReference
         would otherwise omit them from the nupkg. -->
    <ItemGroup>
        <PackageReference Include="Silk.NET" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Windowing.Common" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Input.Common" Version="2.23.0" />
        <PackageReference Include="SkiaSharp" Version="4.153.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="Svg.Skia" Version="5.2.3" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="icon.png" />
    </ItemGroup>

    <!-- Restore uses the project name (Blossom.Pack). The nupkg id must be Blossom. -->
    <Target Name="_UseBlossomPackageId" BeforeTargets="GenerateNuspec">
        <PropertyGroup>
            <PackageId>Blossom</PackageId>
        </PropertyGroup>
    </Target>

    <Target Name="_PackBlossomAssemblies" DependsOnTargets="Build">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetDir)Blossom.dll" PackagePath="lib/$(TargetFramework)/" />
            <TfmSpecificPackageFile Include="$(TargetDir)Blossom.pdb" PackagePath="lib/$(TargetFramework)/" Condition="Exists('$(TargetDir)Blossom.pdb')" />
            <TfmSpecificPackageFile Include="$(TargetDir)Blossom.Reactive.dll" PackagePath="lib/$(TargetFramework)/" />
            <TfmSpecificPackageFile Include="$(TargetDir)Blossom.Reactive.pdb" PackagePath="lib/$(TargetFramework)/" Condition="Exists('$(TargetDir)Blossom.Reactive.pdb')" />
            <TfmSpecificPackageFile Include="$(TargetDir)Blossom.Primitives.dll" PackagePath="lib/$(TargetFramework)/" />
            <TfmSpecificPackageFile Include="$(TargetDir)Blossom.Primitives.pdb" PackagePath="lib/$(TargetFramework)/" Condition="Exists('$(TargetDir)Blossom.Primitives.pdb')" />
        </ItemGroup>
    </Target>
</Project>
