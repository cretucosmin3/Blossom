<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ApplicationIcon>..\..\icon64.ico</ApplicationIcon>
        <RootNamespace>Blossom.Testing</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Blossom\Blossom.csproj" />
        <ProjectReference Include="..\..\src\Blossom.Desktop\Blossom.Desktop.csproj" />
        <ProjectReference Include="..\..\src\Blossom.Reactive\Blossom.Reactive.csproj" />
        <ProjectReference Include="..\..\src\Blossom.Primitives\Blossom.Primitives.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\assets\**\*">
            <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <None Include="..\..\glfw\**\*">
            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>
</Project>
