{
    "version": "2.0.0",
    "options": {
        "env": {
            "PATH": "/home/kozmo/.dotnet:/home/kozmo/.local/bin:${env:PATH}",
            "DOTNET_ROOT": "/home/kozmo/.dotnet"
        }
    },
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/Blossom.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/Blossom.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Blossom.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
